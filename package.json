{
  "name": "tidyread",
  "version": "0.1.0",
  "description": "Clean an article once, hand it to Instapaper's parser pre-chewed, and build a Kobo-ready EPUB.",
  "main": "dist/cli.js",
  "scripts": {
    "test": "node --test",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm test",
    "prepublishOnly": "npm run check",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "instapaper",
    "kobo",
    "epub",
    "kepub",
    "readability",
    "read-later",
    "article",
    "e-ink",
    "defuddle"
  ],
  "author": "parzival1l <nandhu02111997@gmail.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "commander": "^15.0.0",
    "defuddle": "^0.19.3",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^7.0.2"
  },
  "bin": {
    "tidyread": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parzival1l/tidyread.git"
  },
  "homepage": "https://github.com/parzival1l/tidyread#readme",
  "bugs": {
    "url": "https://github.com/parzival1l/tidyread/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
